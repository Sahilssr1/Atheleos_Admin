# ── Atheleos Admin API — environment ─────────────────────────────────────────
# Copy to .env (never commit the real file). All secrets stay server-side.

PORT=4000
NODE_ENV=development
# Browser origin of the admin web app (CORS + cookie). Production example: https://admin.atheleos.in
WEB_ORIGIN=http://localhost:5174

# ── Data mode ────────────────────────────────────────────────────────────────
# firestore = production (default). memory = LOCAL DEV/TESTS ONLY — data is
# in-process, resets on restart, and must never be used in production.
DATA_MODE=firestore

# ── Firebase (same project as Atheleos_App: atheleos-4a146) ─────────────────
# Service account for the Admin SDK. Use ONE of:
# 1) GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# 2) FIREBASE_SERVICE_ACCOUNT_JSON=<single-line JSON>  (secret manager friendly)
FIREBASE_PROJECT_ID=atheleos-4a146
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Local emulator (optional): FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ── Admin session security ───────────────────────────────────────────────────
# Long random string (>=32 chars). Rotating it revokes all admin sessions.
ADMIN_JWT_SECRET=
SESSION_TTL_HOURS=8
# Comma-separated staff email domains allowed to be created as admins (optional allow-list)
ADMIN_EMAIL_DOMAINS=

# ── Bootstrap (first Super Admin) ────────────────────────────────────────────
# Used only by `npm run bootstrap-admin`. Remove after first use.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# ── Outgoing email (SMTP — e.g. Hostinger, same mailbox family as the app) ──
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Atheleos <contact@atheleos.in>"

# ── Incoming email (IMAP — required for the Email Center inbox) ─────────────
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=

# ── Integration health checks (optional) ────────────────────────────────────
# Cloudflare media worker URL from Atheleos_App (cloudflare_worker/)
MEDIA_WORKER_URL=
# Firebase Functions base, e.g. https://us-central1-atheleos-4a146.cloudfunctions.net
FUNCTIONS_BASE_URL=
